# ==============================================================================
# Portfolio Environment Variables
# ==============================================================================

# Contact Form Email Delivery (Resend)
# ------------------------------------------------------------------------------
# Required in production to deliver contact form submissions.
# Sign up and generate an API key at https://resend.com/api-keys
# In local development without this key, submissions are logged and simulated.
RESEND_API_KEY=re_your_api_key_here

# (Optional) Verified sender address.
# Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Once you verify your domain on Resend, switch to e.g. "Miloš Minić <contact@milosminic.net>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# (Optional) Destination inbox for contact form submissions.
# Defaults to "minicm034@gmail.com".
CONTACT_NOTIFICATION_EMAIL=minicm034@gmail.com

# GitHub Integration
# ------------------------------------------------------------------------------
# (Optional) Personal access token with read access to public repositories.
# Increases GitHub API rate limits from 60 req/hr (unauthenticated) to 5,000 req/hr.
# If omitted or rate-limited, the site automatically serves a built-in static snapshot.
GITHUB_TOKEN=ghp_your_github_token_here
